---
import bootstrap from '../../../agent-report/bootstrap.json';
import { renderStories, renderHealth } from '../../lib/agent-report.mjs';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>Agent Report — AI &amp; agentic coding news</title>
    <meta name="description" content="Plain headlines for AI and agentic coding. Ranked by editorial prominence, developer attention and independent source agreement." />
    <link rel="canonical" href="https://antonioskilton.com/agent-report" />
    <link rel="alternate" type="application/rss+xml" title="Agent Report" href="/agent-report/feed.xml" />
    <meta property="og:title" content="Agent Report" />
    <meta property="og:description" content="AI and agentic coding news. Plain headlines, visible points, inspectable sources." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Ctext x='20' y='30' text-anchor='middle' font-family='Georgia,serif' font-weight='bold' font-size='29'%3EAR%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#front-page">Skip to headlines</a>
    <main>
      <header>
        <h1>AGENT REPORT</h1>
        <p class="tagline">AI &amp; AGENTIC CODING</p>
        <div class="edition-line"><time id="edition-time" datetime={bootstrap.generated_at}>{bootstrap.generated_at.replace('T', ' ').replace('Z',' UTC')}</time><span> · </span><a href="/agent-report/feed.xml">RSS</a><span> · </span><button id="refresh" type="button">Refresh</button></div>
        <label class="scope">View <select id="scope"><option value="all">Coding + agents</option><option value="coding">Coding</option><option value="agents">Broader agents</option></select></label>
        <p id="status" class="status" role="status"></p>
      </header>
      <section id="front-page" aria-label="Ranked news headlines" set:html={renderStories(bootstrap.stories)} />
      <noscript><p class="notice">Showing the edition captured at the time above. Use the RSS feed for automatically refreshed editions without JavaScript.</p></noscript>
      <footer>
        <details><summary>How stories are selected</summary><p>Editorial prominence comes first: Techmeme main headlines and specialist editorial publications. Hacker News rank supplies developer attention. Distinct sources and repeated prominence add capped points. A model groups coverage and writes headlines; code calculates every point.</p><p>Each source counts once per development. Repeated copies from the same source add nothing. Topic relevance limits the page to AI coding, developer tools, coding-capable models and AI agents.</p><p>AI headlines receive a separate factual check against retrieved source text. Material rollout limits and uncertainty must be retained. When the check fails, the original source headline is used. These checks do not independently verify a publisher’s claims.</p></details>
        <details><summary>Sources &amp; update status</summary><p>Refreshes are scheduled every four hours. A failed collection preserves the last good edition. Missing source coverage is not evidence that a story is unimportant.</p><div id="source-health" set:html={renderHealth(bootstrap)} /></details>
        <p class="footer-links"><a href="https://github.com/phinneywood/personal-site/tree/main/docs/agent-report">Method &amp; source code</a><span> · </span><a href="https://github.com/phinneywood/personal-site/issues/new?title=Agent%20Report%20feedback">Feedback / correction</a></p>
      </footer>
    </main>
    <script id="initial-edition" type="application/json" set:html={JSON.stringify(bootstrap).replace(/</g, '\\u003c')} />
    <script>
      import { renderStories, renderHealth, validEdition } from '../../lib/agent-report.mjs';
      let edition = JSON.parse(document.getElementById('initial-edition')!.textContent!);
      const scope = document.getElementById('scope') as HTMLSelectElement;
      const button = document.getElementById('refresh') as HTMLButtonElement;
      const status = document.getElementById('status')!;
      function render() {
        const stories = edition.stories.filter((s: {scope: string}) => scope.value === 'all' || s.scope === scope.value);
        document.getElementById('front-page')!.innerHTML = renderStories(stories);
        document.getElementById('source-health')!.innerHTML = renderHealth(edition);
        const time = document.getElementById('edition-time')!;
        time.setAttribute('datetime', edition.generated_at);
        time.textContent = new Intl.DateTimeFormat(undefined, {month:'short', day:'numeric', hour:'numeric', minute:'2-digit', timeZoneName:'short'}).format(new Date(edition.generated_at));
        const stale = Date.now() - Date.parse(edition.generated_at) > 12 * 60 * 60 * 1000;
        status.textContent = stale ? 'This edition is over 12 hours old. Showing the last available headlines.' : edition.status === 'degraded' ? 'Some sources have no fresh coverage. Details below.' : '';
      }
      async function refresh() {
        button.disabled = true;
        try {
          const response = await fetch('/agent-report/current.json', {cache:'no-cache', signal:AbortSignal.timeout(10000)});
          if (!response.ok) throw new Error('Feed unavailable');
          const data = await response.json();
          if (!validEdition(data)) throw new Error('Invalid feed');
          if (Date.parse(data.generated_at) >= Date.parse(edition.generated_at)) edition = data;
          render();
        } catch {
          render();
          status.textContent = 'Live refresh unavailable. Showing the saved edition from the time above.';
        } finally { button.disabled = false; }
      }
      scope.addEventListener('change', render);
      button.addEventListener('click', refresh);
      render();
      refresh();
    </script>
    <style is:global>
      :root{color-scheme:light;font-family:Arial,Helvetica,sans-serif;color:#111;background:#fff;font-synthesis:none}
      *{box-sizing:border-box}body{margin:0;font-size:16px;line-height:1.3}main{max-width:1160px;margin:auto;padding:12px 20px 24px}a{color:#0000b8;text-decoration:underline;text-underline-offset:2px}a:visited{color:#551a8b}a:focus-visible,button:focus-visible,summary:focus-visible,select:focus-visible{outline:2px solid #0000b8;outline-offset:3px}.skip{position:absolute;left:12px;top:-100px;background:white;padding:8px}.skip:focus{top:8px}
      header{text-align:center;border-bottom:1px solid #bbb;padding-bottom:7px;margin-bottom:8px}h1{font:bold 30px/1 Georgia,serif;letter-spacing:-1px;margin:0 0 4px}.tagline{font-size:10px;letter-spacing:1px;margin:0 0 5px;color:#555}.edition-line{font-size:12px;color:#666}.edition-line button{font:inherit;color:#0000b8;border:0;background:none;padding:3px;cursor:pointer;text-decoration:underline}.scope{display:block;color:#666;font-size:12px;margin-top:5px}.scope select{font:inherit;color:#111;background:white;border:1px solid #ccc;padding:2px}.status{font-size:12px;color:#754400;margin:4px 0 0;min-height:0}.status:empty{display:none}
      .lead{text-align:center;max-width:820px;margin:0 auto 6px;padding:3px 0 8px;border-bottom:1px solid #bbb}.lead h2{font:bold 23px/1.18 Arial,sans-serif;margin:0}.stories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 24px}.story{padding:5px 0;min-width:0}.story h3{font:16px/1.3 Arial,sans-serif;margin:0;overflow-wrap:anywhere}.story-details{margin-top:2px;font-size:14px;color:#666}.story-details>summary{font-size:12px;line-height:1.25;white-space:nowrap;list-style:none;cursor:pointer}.story-details>summary::-webkit-details-marker{display:none}.story-details>summary::before{content:'+ '}.story-details[open]>summary::before{content:'− '}.story-details strong{font-weight:normal}.detail-body{text-align:left;padding:8px;background:#f5f5f5;color:#111;margin-top:4px;overflow-wrap:anywhere}.detail-body p{margin:0 0 8px}.category,.check{font-size:12px;color:#555}.detail-body ul{padding-left:17px;margin:6px 0 9px}.detail-body li{margin-bottom:6px;font-size:13px}.detail-body time{font-size:11px;color:#666}.evidence-heading{font-size:13px;font-weight:bold}.detail-body table{width:100%;border-collapse:collapse;font-size:12px;margin-bottom:8px}.detail-body th{font-weight:normal;text-align:left}.detail-body td{text-align:right}.detail-body td,.detail-body th{border-bottom:1px solid #ddd;padding:3px 0}.empty{font-size:14px;padding:20px;text-align:center}
      footer{margin-top:12px;border-top:1px solid #bbb;padding-top:8px;font-size:12px;color:#666}footer details{margin-bottom:6px}footer summary{cursor:pointer}footer p{line-height:1.5;max-width:800px;margin:6px 0}footer li{margin-bottom:4px}.footer-links{font-size:11px}.notice{font-size:12px;color:#754400}@media(max-width:760px){main{padding:10px 14px}.stories{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 18px}}@media(max-width:470px){main{padding:10px 12px}h1{font-size:27px}.lead h2{font-size:21px}.stories{grid-template-columns:1fr}.story{padding:5px 0}.lead{padding-bottom:7px}}
      @media(forced-colors:active){.detail-body{border:1px solid CanvasText}a:focus-visible,summary:focus-visible,button:focus-visible,select:focus-visible{outline:2px solid Highlight}}
    </style>
  </body>
</html>
